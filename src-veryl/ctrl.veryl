module ctrl (
    clk      : input  'p clock          ,
    clk_n    : input  'p clock_negedge  ,
    rst_n    : input  'p reset_async_low,

    instr    : input  'p logic<16>      ,
    pc       : output 'p logic<5>       ,
    pc_next  : output 'p logic<5>       ,
    sta_en   : output 'p logic          ,

    rst_init : output 'p logic          ,
    upd_en   : output 'p logic          ,
    scan_row : output 'p logic<4>       ,
    pair2    : output 'p logic          ,
    ra_sel   : output 'p logic          ,
    ra_row   : output 'p logic<4>       ,

    match    : input  'p logic<16>      ,
    sram_addr: output 'p logic<4>       ,
    sram_csb : output 'p logic          ,
    sram_web : output 'p logic          ,
    sram_din : output 'p logic<32>      ,
    dreg     : output 'p logic<32>      ,

    sram_dout: input  'p logic<32>      ,

    q_wr_en  : output 'p logic          ,
    q_wr_dat : output 'p logic<32>      ,
    a_wr_en  : output 'p logic          ,
    a_wr_dat : output 'p logic<32>      ,
    m_wr_en  : output 'p logic          ,
    m_wr_dat : output 'p logic<32>      ,

    scan_op  : output 'p logic<3>       ,
    use_xor_o: output 'p logic<4>       ,
    use_xor2_o: output 'p logic<4>      ,
    emit_src : output 'p logic<4>       ,
    emit_en  : output 'p logic          ,

    strobe   : input  'p logic          ,
    wb_en    : output 'p logic          ,
    wb_dst   : output 'p logic<2>       ,
    wb_pos   : output 'p logic<2>       ,

    br_threshold_hit: input  'p logic  ,
    br_min_valid    : input  'p logic  ,
    br_count_nz     : input  'p logic  ,
    br_match_nz     : input  'p logic  ,
    br_a_zero       : input  'p logic  ,

    busy     : output 'p logic          ,
    halted   : output 'p logic          ,
) {
    var fsm       : 'p logic<3>;
    var pc_r      : 'p logic<5>;
    var scan_row_r: 'p logic<4>;
    var scan_end_r: 'p logic<4>;
    var dual_r    : 'p logic;
    var scan_op_r : 'p logic<3>;
    var sel_m_r   : 'p logic;
    var sel_r     : 'p logic<16>;

    var opc: 'p logic<4>;
    var fA : 'p logic<4>;
    var fB : 'p logic<4>;
    var fC : 'p logic<4>;
    assign opc = instr[15:12];
    assign fA  = instr[11:8];
    assign fB  = instr[7:4];
    assign fC  = instr[3:0];

    var in_fetch: 'p logic;
    var in_scan : 'p logic;
    var in_wait : 'p logic;
    var in_halt : 'p logic;
    var in_ld   : 'p logic;
    assign in_fetch = ~(fsm[2] | fsm[1] | fsm[0]);
    assign in_scan  = ~(fsm[2] | fsm[1]) & fsm[0];
    assign in_wait  =  ~fsm[2] & fsm[1] & ~fsm[0];
    assign in_halt  =  ~fsm[2] & fsm[1] &  fsm[0];
    assign in_ld    =   fsm[2] & ~fsm[1] & ~fsm[0];

    var is_scan    : 'p logic;
    var is_scanm   : 'p logic;
    var scan_start : 'p logic;
    var dual_issue : 'p logic;
    var ld_issue   : 'p logic;
    var ld_q       : 'p logic;
    var ld_a       : 'p logic;
    var ld_m       : 'p logic;
    var is_sta     : 'p logic;
    var is_emit    : 'p logic;
    var is_waitbyte: 'p logic;
    var is_branch  : 'p logic;
    var is_halt    : 'p logic;
    var is_clrmsk  : 'p logic;
    assign is_scan     = in_fetch & ((opc == 4'd4) | (opc == 4'd10) | (opc == 4'd11));
    assign is_scanm    = in_fetch & (opc == 4'd11);
    assign dual_issue  = in_fetch & (opc == 4'd10) & ((fC[2:0] == 3'd3) | (fC[2:0] == 3'd4) | (fC[2:0] == 3'd5));
    assign ld_issue    = in_fetch & ((opc == 4'd0) | (opc == 4'd1) | (opc == 4'd2));
    assign ld_q        = in_ld & (opc == 4'd0);
    assign ld_a        = in_ld & (opc == 4'd1);
    assign ld_m        = in_ld & (opc == 4'd2);
    assign is_sta      = in_fetch & (opc == 4'd3);
    assign is_emit     = in_fetch & (opc == 4'd6);
    assign is_waitbyte = in_fetch & (opc == 4'd5);
    assign is_branch   = in_fetch & (opc == 4'd7);
    assign is_halt     = in_fetch & (opc == 4'd8);
    assign is_clrmsk   = in_fetch & (opc == 4'd9);

    var scan_end_raw  : 'p logic<5>;
    var scan_end_clamp: 'p logic<4>;
    assign scan_end_raw = {1'b0, fA} + {1'b0, fB};
    always_comb {
        if scan_end_raw[4] { scan_end_clamp = 4'd15; }
        else               { scan_end_clamp = scan_end_raw[3:0]; }
    }

    var ffs_in  : 'p logic<16>;
    var ffs_pfx : 'p logic<16>;
    var ffs_low : 'p logic<16>;
    var ffs_any : 'p logic;
    var sel_row : 'p logic<4>;
    var sel_use : 'p logic;
    always_comb {
        if in_fetch { ffs_in = match; }
        else        { ffs_in = sel_r; }
    }
    always_comb {
        ffs_pfx[0] = 1'b0;
        for i in 1..16 {
            ffs_pfx[i] = ffs_pfx[i - 1] | ffs_in[i - 1];
        }
    }
    assign ffs_low = ffs_in & ~ffs_pfx;
    assign ffs_any = ffs_pfx[15] | ffs_in[15];
    assign sel_row = {|(ffs_low & 16'hFF00), |(ffs_low & 16'hF0F0), |(ffs_low & 16'hCCCC), |(ffs_low & 16'hAAAA)};
    assign sel_use = is_scanm | (in_scan & sel_m_r);
    assign scan_start = is_scan & (~is_scanm | ffs_any);

    var scan_last: 'p logic;
    always_comb {
        if sel_m_r { scan_last = ~ffs_any; }
        else       { scan_last = (scan_row_r == scan_end_r) | (dual_r & (scan_row_r + 4'd1 == scan_end_r)); }
    }
    assign pair2     = in_scan & dual_r & (scan_row_r != scan_end_r);
    assign ra_sel    = dual_issue | (in_scan & dual_r & ~scan_last);
    always_comb {
        if dual_issue { ra_row = fA + 4'd1; }
        else          { ra_row = scan_row_r + 4'd3; }
    }

    var sram_rd_en : 'p logic;
    var sram_addr_v: 'p logic<4>;
    assign sram_rd_en = scan_start | ld_issue | (in_scan & ~scan_last);
    always_comb {
        if sel_use             { sram_addr_v = sel_row; }
        else if is_scan | ld_issue { sram_addr_v = fA; }
        else if dual_r         { sram_addr_v = scan_row_r + 4'd2; }
        else                   { sram_addr_v = scan_row_r + 4'd1; }
    }
    always_comb {
        if sram_rd_en { sram_addr = sram_addr_v; }
        else          { sram_addr = 4'd0; }
    }
    assign sram_csb = ~sram_rd_en;
    assign sram_web    = 1'b1;
    assign sram_din    = 32'd0;

    assign dreg = sram_dout;

    assign pc       = pc_r;
    always_comb {
        if in_fetch { scan_op = fC[2:0]; }
        else        { scan_op = scan_op_r; }
    }
    for i in 0..4 :g_ux {
        inst u_ux: hades_dupff (
            clk                    ,
            rst_n                  ,
            en   : is_scan         ,
            d    : ~fC[2]          ,
            q    : use_xor_o[i]    ,
        );
    }
    for i in 0..4 :g_ux2 {
        inst u_ux2: hades_dupff (
            clk                     ,
            rst_n                   ,
            en   : is_scan          ,
            d    : ~fC[2]           ,
            q    : use_xor2_o[i]    ,
        );
    }
    assign sta_en   = is_sta;
    assign rst_init = is_scan & ~fC[3];
    assign upd_en   = in_scan;
    assign scan_row = scan_row_r;
    assign emit_src = fA;
    assign emit_en  = is_emit;
    assign busy     = ~in_fetch & ~in_halt;
    assign halted   = in_halt;

    assign wb_en  = (is_waitbyte | in_wait) & strobe;
    assign wb_dst = fA[3:2];
    assign wb_pos = fA[1:0];

    assign q_wr_en  = ld_q;
    assign q_wr_dat = dreg;
    assign a_wr_en  = ld_a;
    assign a_wr_dat = dreg;
    assign m_wr_en  = ld_m | is_clrmsk;
    always_comb {
        if is_clrmsk { m_wr_dat = 32'hFFFF_FFFF; }
        else         { m_wr_dat = dreg; }
    }

    var off8        : 'p logic<8>;
    var b_target    : 'p logic<5>;
    var branch_taken: 'p logic;
    assign off8     = {fB, fC};
    assign b_target = pc_r + 5'd1 + off8[4:0];
    always_comb {
        case fA {
            4'd0:    branch_taken = 1'b1;
            4'd1:    branch_taken = br_threshold_hit;
            4'd2:    branch_taken = ~br_threshold_hit;
            4'd3:    branch_taken = br_min_valid;
            4'd4:    branch_taken = br_count_nz;
            4'd5:    branch_taken = br_match_nz;
            4'd6:    branch_taken = br_a_zero;
            4'd7:    branch_taken = ~br_a_zero;
            default: branch_taken = 1'b0;
        }
    }

    var pc_nx: 'p logic<5>;
    always_comb {
        pc_nx = pc_r;
        if in_fetch {
            if is_halt {
                pc_nx = pc_r;
            } else if scan_start | ld_issue {
                pc_nx = pc_r;
            } else if is_waitbyte {
                if strobe { pc_nx = pc_r + 5'd1; }
            } else if is_branch {
                if branch_taken { pc_nx = b_target; }
                else            { pc_nx = pc_r + 5'd1; }
            } else {
                pc_nx = pc_r + 5'd1;
            }
        } else if in_scan {
            if scan_last { pc_nx = pc_r + 5'd1; }
        } else if in_wait {
            if strobe { pc_nx = pc_r + 5'd1; }
        } else if in_ld {
            pc_nx = pc_r + 5'd1;
        }
    }
    assign pc_next = pc_nx;

    always_ff (clk, rst_n) {
        if_reset {
            fsm        = 3'd0;
            pc_r       = 5'd0;
            scan_row_r = 4'd0;
            scan_end_r = 4'd0;
            dual_r     = 1'b0;
            scan_op_r  = 3'd0;
            sel_m_r    = 1'b0;
            sel_r      = 16'd0;
        } else {
            sel_r = ffs_in & ffs_pfx;
            pc_r = pc_nx;
            if in_fetch {
                if is_halt {
                    fsm = 3'd3;
                } else if scan_start {
                    if is_scanm { scan_row_r = sel_row; }
                    else        { scan_row_r = fA; }
                    scan_end_r = scan_end_clamp;
                    dual_r     = dual_issue;
                    sel_m_r    = is_scanm;
                    scan_op_r  = fC[2:0];
                    fsm        = 3'd1;
                } else if ld_issue {
                    fsm = 3'd4;
                } else if is_waitbyte {
                    if strobe {
                    } else {
                        fsm = 3'd2;
                    }
                } else if is_branch {
                    if branch_taken {
                    } else {
                    }
                } else {
                }
            } else if in_scan {
                if scan_last {
                    fsm  = 3'd0;
                } else {
                    if sel_m_r      { scan_row_r = sel_row; }
                    else if dual_r  { scan_row_r = scan_row_r + 4'd2; }
                    else            { scan_row_r = scan_row_r + 4'd1; }
                }
            } else if in_wait {
                if strobe {
                    fsm  = 3'd0;
                }
            } else if in_ld {
                fsm = 3'd0;
            }
        }
    }
}
